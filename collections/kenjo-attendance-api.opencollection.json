                "name": "attendanceId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the attendance entry."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an attendance"
        },
        {
          "info": {
            "name": "Delete an attendance",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.kenjo.io/api/v1/attendances/:attendanceId",
            "params": [
              {
                "name": "attendanceId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the attendance entry."
              }
            ]
          },
          "docs": "Delete an attendance"
