{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kenjo Attendance Documents API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List company documents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kenjo.io/api/v1/documents/company",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index for paginated results."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return per page."
              }
            ]
          },
          "docs": "Returns a paginated list of company documents."
        }
      ]
    }
  ],
  "bundled": true
}